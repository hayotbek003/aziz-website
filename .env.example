# ---------- Обязательные в продакшене ----------
# PostgreSQL (Neon / Supabase / Vercel Postgres). Формат postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Токен платформенного бота от @BotFather
BOT_TOKEN=
# Публичный адрес проекта Vercel (без слеша в конце)
WEBAPP_URL=https://aziz.vercel.app
# Случайная строка 32+ символа: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Ключ шифрования токенов ботов продавцов: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Секрет webhook Telegram (латиница/цифры/_-): python -c "import secrets;print(secrets.token_hex(24))"
WEBHOOK_SECRET=
# Секрет Vercel Cron (Vercel передаёт его в заголовке Authorization)
CRON_SECRET=
# Telegram ID владельцев платформы через запятую
ADMIN_TELEGRAM_IDS=

# ---------- Необязательные ----------
BOT_USERNAME=
TRIAL_DAYS=7
MANUAL_PAYMENT_INFO=Переведите сумму на карту 8600 **** **** 0000 (Click/Payme) и укажите номер чека.
# Только для локальной разработки: вход без Telegram + SQLite
DEV_MODE=false
