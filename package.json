{
  "name": "aziz-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,cyan \"next dev\" \"npm:api\"",
    "web": "next dev",
    "api": "python -m uvicorn api.index:app --reload --port 8000 --reload-dir backend --reload-dir api",
    "bot": "python -m backend.run_polling",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "0.453.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
